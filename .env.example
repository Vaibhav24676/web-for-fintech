# Existing MongoDB URI (PRIMARY DATABASE - keep unchanged)
MONGODB_URI=mongodb://localhost:27017/fintech_main

# Partner Portal Database (SECONDARY DATABASE - new)
PARTNER_DB_URI=mongodb://localhost:27017/partner_portal

# Bank API Configuration
BANK_API_URL=https://bank-api.example.com
BANK_API_KEY=your_bank_api_key_here

# RSA Key Paths for Encryption/Decryption
RSA_PRIVATE_KEY_PATH=./keys/partner_private_key.pem
RSA_PUBLIC_KEY_PATH=./keys/partner_public_key.pem

# Partner Portal Authentication
PARTNER_PORTAL_SECRET=your_partner_portal_jwt_secret_here
PARTNER_PORTAL_API_KEY=partner-portal-webhook-key

# mTLS Certificate Paths (Optional - for production)
CLIENT_CERT_PATH=./certs/client.crt
CLIENT_KEY_PATH=./certs/client.key
CA_CERT_PATH=./certs/ca.crt

# Existing Environment Variables (keep unchanged)
JWT_SECRET=your_existing_jwt_secret
PORT=5000
NODE_ENV=development
API_BASE_URL=https://localhost:5000/v1
MIN_CONSENT_DURATION_MS=3600000
