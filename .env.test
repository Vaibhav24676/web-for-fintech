# Environment variables for testing the fintech backend with Partner Portal
# Copy this to .env for local development

# Main Database (Primary)
MONGODB_URI=mongodb://localhost:27017/fintech_bank

# Partner Portal Database (Secondary)
PARTNER_DB_URI=mongodb://localhost:27017/partner_portal

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# API Configuration
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1

# Partner Portal Configuration
PARTNER_JWT_SECRET=your_partner_portal_jwt_secret_here
PARTNER_JWT_EXPIRES_IN=1h

# Consent Management
MIN_CONSENT_DURATION_MS=3600000

# RSA Keys for Partner Portal (generate these for production)
RSA_PRIVATE_KEY_PATH=./keys/partner_private.pem
RSA_PUBLIC_KEY_PATH=./keys/partner_public.pem

# Bank API Configuration for Partner Portal
BANK_API_URL=http://localhost:5000/api/v1
BANK_API_TIMEOUT=30000

# Security
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_ALGORITHM=RSA-OAEP-256

# Testing
NODE_ENV=development
